{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "sap": {
        "type": "local",
        "command": [
          "node",
          "C:\\Users\\bodim\\Desktop\\Projects\\opencode\\abap-mcp-readonly-v2\\native\\node_modules\\abap-adt-mcp\\dist\\index.js"
        ],
        "environment": {
          "SAP_SYSTEMS_FILE": "C:\\Users\\bodim\\Desktop\\Projects\\fabric\\abap-mcp-readonly-v2\\systems.native.json",
          "MCP_READ_ONLY": "1",
          "MCP_TOOLSETS": "source,objects,data",
          "MCP_MAX_RESPONSE_CHARS": "12000"
        },
        "codemode": false,
        "timeout": {
          "startup": 30000,
          "catalog": 30000,
          "execution": 120000
        }
      }
    }
  },
  "permissions": [
